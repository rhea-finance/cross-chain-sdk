{
  "name": "@rhea-finance/cross-chain-sdk",
  "version": "0.1.22",
  "description": "Cross-chain lending SDK",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test:batch-views-errors": "pnpm build && node scripts/batch-views-error-test.mjs",
    "test:near-rpc-failover": "pnpm build && node scripts/near-rpc-failover-test.mjs",
    "prettier:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "lending",
    "cross-chain",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "big.js": "7.0.1",
    "buffer": "6.0.3",
    "decimal.js": "10.6.0",
    "ethers": "6.17.0",
    "lodash": "4.18.1",
    "mathjs": "15.2.0",
    "near-api-js": "5.1.1",
    "ramda": "0.32.0",
    "util": "0.12.5"
  },
  "devDependencies": {
    "@types/big.js": "6.2.2",
    "@types/lodash": "4.17.25",
    "@types/node": "20.19.25",
    "prettier": "3.6.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
